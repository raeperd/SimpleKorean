{
  "description": "Load Simple Korean rules automatically for each Codex session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${PLUGIN_ROOT}\" ] && node \"${PLUGIN_ROOT}/src/hooks/simple-korean-activate.js\" || true",
            "timeout": 5,
            "statusMessage": "Loading Simple Korean...",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
